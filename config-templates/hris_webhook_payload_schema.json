{
  "_comment": "HRIS webhook payload schema v1.0.0. All inbound payloads to JML-J, JML-M, JML-L must conform to this structure.",
  "_version": "1.0.0",
  "type": "object",
  "required": ["eventType", "eventSource", "eventId", "eventTimestamp", "identity"],
  "properties": {
    "eventType": {
      "type": "string",
      "enum": ["joiner", "mover", "leaver"],
      "description": "Lifecycle event type"
    },
    "eventSource": {
      "type": "string",
      "enum": ["hris", "itsm"],
      "description": "Origin of the event"
    },
    "eventId": {
      "type": "string",
      "description": "UUID generated by source system for deduplication"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime of event generation in source system"
    },
    "identity": {
      "type": "object",
      "required": ["employeeNumber", "firstName", "lastName", "email", "employeeType", "department", "managerId"],
      "properties": {
        "employeeNumber": {"type": "string"},
        "firstName": {"type": "string"},
        "lastName": {"type": "string"},
        "email": {"type": "string", "format": "email"},
        "displayName": {"type": "string", "description": "Derived if absent"},
        "employeeType": {"type": "string", "enum": ["employee", "contractor", "service-account"]},
        "department": {"type": "string", "description": "Must match ilm_access_map key"},
        "title": {"type": "string"},
        "managerId": {"type": "string", "description": "employeeNumber of direct manager"},
        "location": {"type": "string"},
        "costCenter": {"type": "string"},
        "startDate": {"type": "string", "format": "date", "description": "Required for joiner"},
        "endDate": {"type": "string", "format": "date", "description": "Required for leaver"}
      }
    },
    "previousValues": {
      "type": "object",
      "description": "Previous attribute values for mover delta calculation",
      "properties": {
        "department": {"type": "string"},
        "employeeType": {"type": "string"},
        "managerId": {"type": "string"},
        "location": {"type": "string"}
      }
    },
    "accessChanges": {
      "type": "object",
      "description": "Explicit access changes for ITSM-initiated events",
      "properties": {
        "add": {"type": "array", "items": {"type": "string"}},
        "remove": {"type": "array", "items": {"type": "string"}}
      }
    },
    "flags": {
      "type": "object",
      "properties": {
        "vip": {"type": "boolean"},
        "contractor": {"type": "boolean"},
        "urgent": {"type": "boolean", "description": "Bypasses future-date scheduling"},
        "expiryDate": {"type": "string", "format": "date"}
      }
    }
  }
}
